# =========================
# Dalipay + Supabase (+ Vercel optional)
# =========================

SECRET_KEY=badilisha-hii-kuwa-siri-ndefu-ya-random

# Database (Supabase pooler port 6543 kwa Vercel)
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_SSLMODE=require

# Supabase Storage
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=upload

# Dalipay (njia pekee ya malipo; base URL imo kwenye msimbo)
DALIPAY_PUBLIC_KEY=
DALIPAY_SECRET_KEY=
# Callback secret (Dalipay → Settings) kuthibitisha saini ya webhook
DALIPAY_CALLBACK_SECRET=
# Webhook URL ya kuweka kwenye Dalipay: https://DOMAIN-YAKO/webhook/dalipay

# SMS (Beem) — hiari
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=INFO

# Web Push (browser / PWA)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:you@example.com

# Firebase Cloud Messaging — Capacitor native push (app imefungwa)
# Firebase Console → Project settings → Cloud Messaging → Server key
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVER_KEY=
