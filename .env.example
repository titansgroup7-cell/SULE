# =========================
# Vercel + Supabase + Pesapal
# =========================
# Weka hizi kwenye Vercel → Project → Settings → Environment Variables

# Flask
SECRET_KEY=badilisha-hii-kuwa-siri-ndefu-ya-random

# =========================
# SUPABASE (Database)
# =========================
# Dashboard → Project Settings → Database → Connect
# Vercel/serverless → Transaction pooler port 6543
# Server ya kawaida → Session 5432 au pooler pia OK
DATABASE_URL=postgresql://postgres.XXXX:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DB_SSLMODE=require

# =========================
# SUPABASE STORAGE (faili)
# =========================
# Project Settings → API
# URL: https://XXXX.supabase.co
# service_role key (secret) — si anon key
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=uploads

# Pesapal API 3.0
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
# live au sandbox
PESAPAL_ENV=live

# Manual payment fallback
PAYMENT_NUMBER=37912416
PAYMENT_NAME=Matondo Maduhu
PAYMENT_NETWORK=Vodacom

# SMS (Beem) — hiari
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=INFO

# Web Push (VAPID) — hiari
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:you@example.com
